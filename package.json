{
  "name": "vape-shop-static-site",
  "version": "1.0.0",
  "description": "Premium static vape shop website built with React, TypeScript, and Tailwind CSS.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base=/app/",
    "build:root": "tsc -b && vite build",
    "prepare:catalyst": "node scripts/prepare-catalyst-client.mjs",
    "build:catalyst": "npm run build && npm run prepare:catalyst",
    "deploy:catalyst": "npm run build:catalyst && catalyst deploy --only client",
    "preview": "vite preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nagud/vape.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nagud/vape/issues"
  },
  "homepage": "https://github.com/nagud/vape#readme",
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16"
  }
}
